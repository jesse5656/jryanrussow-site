{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:russow-institute:ai-skills:validation:operator-response:v1",
  "title": "Governed AI Skill Packaging and Deployment Operator Response V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "mode",
    "result",
    "resulting_deployment_status",
    "authority_findings",
    "deterministic_checks",
    "human_control",
    "findings",
    "exact_next_action"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "pattern": "^F(?:0[1-9]|1[0-9]|20)$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "DISCOVER",
        "PACKAGE",
        "REGISTER",
        "DEPLOY",
        "VERIFY",
        "ROLLBACK",
        "AUDIT"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_MISSING_AUTHORITY",
        "BLOCKED_MISSING_ARTIFACT",
        "BLOCKED_HASH_MISMATCH",
        "BLOCKED_UNSUPPORTED_RUNTIME",
        "BLOCKED_DEPENDENCY",
        "BLOCKED_GOVERNANCE",
        "DRIFT_DETECTED",
        "ROLLBACK_REQUIRED",
        "HUMAN_REVIEW",
        "UNKNOWN"
      ]
    },
    "resulting_deployment_status": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "enum": [
            "NOT_DEPLOYED",
            "DEPLOYED_VERIFIED",
            "DEPLOYED_UNVERIFIED",
            "BLOCKED",
            "DRIFT_DETECTED",
            "ROLLED_BACK",
            "RETIRED",
            "UNKNOWN"
          ]
        }
      ]
    },
    "authority_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deterministic_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "status",
          "evidence"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "human_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reason"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exact_next_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
